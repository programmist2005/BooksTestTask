@model List<BooksTestTask.ViewModels.ShortInfoBook>

@{
	ViewData["Title"] = "Список книг";
}

<h2>Список книг</h2>

<form asp-action="Index" method="get" class="row g-3 mb-4">
	<div class="col-md-3">
		<label class="form-label">Название</label>
		<input type="text" name="title" value="@ViewBag.BookTitle" class="form-control" placeholder="Поиск по названию" />
	</div>

	<div class="col-md-3">
		<label class="form-label">Автор</label>
		<input type="text" name="author" value="@ViewBag.BookAuthor" class="form-control" placeholder="Поиск по автору" />
	</div>

	<div class="col-md-3">
		<label class="form-label">Оглавление</label>
		<input type="text" name="toc" value="@ViewBag.BookToc" class="form-control" placeholder="Поиск по оглавлению" />
	</div>

	<div class="col-md-3 d-flex align-items-end">
		<button type="submit" class="btn btn-primary me-2">Найти</button>
		<a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
	</div>
</form>

<p>
	<a asp-action="Create" class="btn btn-primary">Добавить книгу</a>
</p>

@if (Model != null && Model.Any())
{
	<table class="table table-hover table-bordered">
		<thead>
			<tr>
				<th>Id</th>
				<th>Название</th>
				<th>Автор</th>
				<th>Год издания</th>
				<th style="width: 180px;">Действия</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var book in Model)
			{
				<tr>
					<td>@book.Id</td>
					<td>@book.Title</td>
					<td>@book.Author</td>
					<td>@book.YearPublished</td>
					<td>
						<a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">Просмотр</a>
						<a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
						<a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="alert alert-info">
		Книги не найдены.
	</div>
}